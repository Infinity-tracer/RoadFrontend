{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://roadpulse-api.onrender.com/api/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "https://roadpulse-api.onrender.com/outputs/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
